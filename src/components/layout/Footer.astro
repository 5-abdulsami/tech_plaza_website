---
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { footerNav, site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <Logo tone="inverse" />
      <p>{site.tagline}. The electronics shops of {site.city}’s tech plazas, in one app.</p>
      <a class="footer__mail" href={`mailto:${site.contact.email}`}>
        <Icon name="mail" size={16} />
        {site.contact.email}
      </a>
    </div>

    <div class="footer__cols">
      {
        footerNav.map((col) => (
          <nav class="footer__col" aria-label={col.title}>
            <h2 class="label footer__heading">{col.title}</h2>
            <ul role="list">
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="container footer__base">
    <p>© {year} {site.name}</p>
    <p class="footer__made"><Icon name="map-pin" size={14} /> Rawalpindi, Pakistan</p>
  </div>

  <p class="footer__word" aria-hidden="true">Tech Plaza</p>
</footer>

<style>
  .footer {
    overflow: hidden;
    padding-top: clamp(3.5rem, 3rem + 3vw, 5.5rem);
    background: var(--brand-900);
    color: rgb(255 255 255 / 0.66);
    font-size: var(--fs-sm);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 3rem;
  }

  .footer__brand {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1.25rem;
    max-width: 22rem;
    line-height: 1.7;
  }

  .footer__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: #fff;
    transition: color var(--dur-fast);
  }

  .footer__mail:hover {
    color: var(--accent);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer__heading {
    margin-bottom: 1.1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule-inverse);
    color: var(--accent);
  }

  .footer__col ul {
    display: grid;
    gap: 0.7rem;
  }

  .footer__col a {
    transition: color var(--dur-fast);
  }

  .footer__col a:hover {
    color: #fff;
  }

  /* Oversized wordmark, cropped by the bottom edge like a shopfront sign. */
  .footer__word {
    margin: clamp(1rem, 0.5rem + 2vw, 2rem) 0 -0.22em;
    font-family: var(--font-display);
    font-size: clamp(4rem, 17.5vw, 17rem);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.05em;
    text-align: center;
    white-space: nowrap;
    color: rgb(255 255 255 / 0.06);
    user-select: none;
  }

  .footer__base {
    position: relative;
    margin-top: clamp(2.5rem, 2rem + 3vw, 4rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--rule-inverse);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer__made {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  @media (max-width: 959px) {
    .footer__top {
      grid-template-columns: 1fr;
    }

    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
