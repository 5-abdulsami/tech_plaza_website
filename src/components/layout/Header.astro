---
import Logo from '@/components/ui/Logo.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { nav } from '@/config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => !href.includes('#') && href === path;
---

<header class="header" data-header>
  <div class="container header__bar">
    <Logo />

    <nav class="header__nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="header__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__cta">
      <Button href="/#download" size="md" icon="arrow-right">Get the app</Button>
    </div>

    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="visually-hidden">Open menu</span>
      <span class="header__burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="menu" id="mobile-menu" data-menu hidden>
    <nav class="container menu__inner" aria-label="Mobile">
      <ul role="list">
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} class="menu__link" data-menu-link>
                {item.label}
                <Icon name="arrow-up-right" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/#download" size="lg" icon="arrow-right" class="menu__cta" data-menu-link>Get the app</Button>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header && toggle && menu) {
    const label = toggle.querySelector('.visually-hidden');

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
      header.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
      } else {
        menu.classList.remove('is-open');
        window.setTimeout(() => {
          if (!menu.classList.contains('is-open')) menu.hidden = true;
        }, 300);
      }
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('[data-menu-link]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 960px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition:
      background-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      backdrop-filter 0.3s var(--ease);
  }

  .header.is-scrolled {
    background: rgb(255 255 255 / 0.82);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    box-shadow: 0 1px 0 var(--border);
  }

  /* No backdrop-filter while open: it would become the containing block of the fixed menu. */
  .header.is-open {
    background: #fff;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: 0 1px 0 var(--border);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .header__nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .header__link {
    position: relative;
    display: block;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-2);
    transition:
      color var(--dur-fast),
      background-color var(--dur-fast);
  }

  .header__link:hover {
    color: var(--text);
    background: rgb(15 23 42 / 0.04);
  }

  .header__link[aria-current='page'] {
    color: var(--brand);
    font-weight: 600;
  }

  .header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-right: -8px;
    border-radius: 12px;
  }

  .header__burger {
    display: grid;
    gap: 6px;
    width: 22px;
    margin: auto;
  }

  .header__burger span {
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.35s var(--ease);
  }

  .is-open .header__burger span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .is-open .header__burger span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Mobile menu */
  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: #fff;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    overflow-y: auto;
  }

  .menu.is-open {
    opacity: 1;
  }

  .menu__inner {
    display: grid;
    gap: 2rem;
    padding-block: 1.5rem 3rem;
  }

  .menu li {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.5s var(--ease);
    transition-delay: calc(var(--i) * 45ms + 60ms);
  }

  .menu.is-open li {
    opacity: 1;
    transform: none;
  }

  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .menu__link :global(svg) {
    color: var(--text-3);
  }

  .menu :global(.menu__cta) {
    width: 100%;
  }

  @media (max-width: 959px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__toggle {
      display: grid;
    }
  }
</style>
