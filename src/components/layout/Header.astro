---
import Logo from '@/components/ui/Logo.astro';
import Button from '@/components/ui/Button.astro';
import { nav, site } from '@/config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => !href.includes('#') && href === path;
---

<header class="header" data-header>
  <div class="container header__bar">
    <Logo />

    <nav class="header__nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="header__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__cta">
      <Button href="/#download">Get the app</Button>
    </div>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="visually-hidden">Open menu</span>
      <span class="header__burger" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <div class="menu" id="mobile-menu" data-menu hidden>
    <nav class="container menu__inner" aria-label="Mobile">
      <p class="label menu__label">Directory</p>
      <ol role="list" class="menu__list">
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} class="menu__link" data-menu-link>
                <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
      <div class="menu__foot" style={`--i:${nav.length}`}>
        <Button href="/#download" variant="accent" size="lg" class="menu__cta" data-menu-link>Get the app</Button>
        <a class="menu__mail" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header && toggle && menu) {
    const label = toggle.querySelector('.visually-hidden');

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
      header.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
      } else {
        menu.classList.remove('is-open');
        window.setTimeout(() => {
          if (!menu.classList.contains('is-open')) menu.hidden = true;
        }, 350);
      }
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('[data-menu-link]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 960px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .header.is-scrolled {
    background: rgb(248 250 252 / 0.86);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom-color: var(--rule);
  }

  /* Navy while the menu is open; no backdrop-filter, which would trap the fixed menu. */
  .header.is-open {
    background: var(--brand-900);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: var(--rule-inverse);
  }

  .header.is-open :global(.logo),
  .header.is-open :global(.logo__word span) {
    color: #fff;
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .header__nav ul {
    display: flex;
    gap: 2rem;
  }

  .header__link {
    position: relative;
    display: block;
    padding: 0.4rem 0;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-2);
    transition: color var(--dur-fast);
  }

  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease);
  }

  .header__link:hover {
    color: var(--text);
  }

  .header__link:hover::after,
  .header__link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__link[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
  }

  .header__toggle {
    display: none;
    width: 46px;
    height: 46px;
    margin-right: -6px;
    border-radius: var(--radius);
  }

  .header__burger {
    display: grid;
    gap: 5px;
    width: 22px;
    margin: auto;
  }

  .header__burger span {
    height: 2px;
    background: var(--text);
    transition:
      transform 0.35s var(--ease),
      opacity 0.2s,
      background-color 0.3s;
  }

  .header__burger span:nth-child(2) {
    width: 60%;
    justify-self: end;
  }

  .is-open .header__burger span {
    background: #fff;
  }

  .is-open .header__burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .is-open .header__burger span:nth-child(2) {
    opacity: 0;
  }

  .is-open .header__burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu: a full-screen plaza directory */
  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: var(--brand-900);
    color: #fff;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.45s var(--ease);
    overflow-y: auto;
  }

  .menu.is-open {
    clip-path: inset(0 0 0 0);
  }

  .menu__inner {
    display: grid;
    gap: 1.5rem;
    padding-block: 2rem 3rem;
  }

  .menu__label {
    color: rgb(255 255 255 / 0.5);
  }

  .menu__list li,
  .menu__foot {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.5s var(--ease);
    transition-delay: calc(var(--i) * 50ms + 120ms);
  }

  .menu.is-open li,
  .menu.is-open .menu__foot {
    opacity: 1;
    transform: none;
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule-inverse);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 6vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .menu__num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--accent);
  }

  .menu__foot {
    display: grid;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .menu :global(.menu__cta) {
    width: 100%;
  }

  .menu :global(.menu__cta .btn__label) {
    flex: 1;
    justify-content: center;
  }

  .menu__mail {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: rgb(255 255 255 / 0.6);
    text-align: center;
  }

  @media (max-width: 959px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__toggle {
      display: grid;
    }
  }
</style>
