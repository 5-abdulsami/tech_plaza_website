---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { IconName } from './icons';

type Variant = 'primary' | 'accent' | 'secondary' | 'light' | 'outline-light' | 'link';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  variant?: Variant;
  size?: 'md' | 'lg';
  /** Icon in the trailing key. Defaults to an arrow; pass `false` for none. */
  icon?: IconName | false;
  /** Small icon before the label. */
  iconStart?: IconName;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon = 'arrow-up-right',
  iconStart,
  class: className,
  ...rest
} = Astro.props;

const external = /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--keyed': icon && variant !== 'link' }, className]}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  {...rest}
>
  <span class="btn__label">
    {iconStart && <Icon name={iconStart} size={17} />}
    <slot />
  </span>
  {
    icon && (
      <span class="btn__key" aria-hidden="true">
        <Icon name={icon} size={18} class="btn__icon" />
      </span>
    )
  }
</a>

<style>
  /*
   * A label plus a separate square "key" holding the arrow. On hover the key
   * fills amber and the arrow slides out and back in, like pressing a button.
   */
  .btn {
    --h: 48px;
    --bg: var(--brand);
    --fg: #fff;
    --line: rgb(255 255 255 / 0.18);
    --key-bg: transparent;
    --key-fg: currentColor;
    --key-hover-bg: var(--accent);
    --key-hover-fg: var(--slate-900);

    position: relative;
    display: inline-flex;
    align-items: stretch;
    min-height: var(--h);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    border: 1.5px solid var(--bd, transparent);
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    isolation: isolate;
    overflow: hidden;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .btn--lg {
    --h: 56px;
    font-size: var(--fs-md);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn__label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0 1.2rem;
  }

  .btn--lg .btn__label {
    padding: 0 1.5rem;
  }

  .btn__key {
    display: grid;
    place-items: center;
    width: var(--h);
    flex: none;
    border-left: 1.5px solid var(--line);
    background: var(--key-bg);
    color: var(--key-fg);
    overflow: hidden;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .btn:hover .btn__key {
    background: var(--key-hover-bg);
    color: var(--key-hover-fg);
  }

  .btn:hover :global(.btn__icon) {
    animation: key-out-in 0.45s var(--ease) both;
  }

  @keyframes key-out-in {
    49% {
      transform: translate(120%, -120%);
    }
    50% {
      transform: translate(-120%, 120%);
    }
    100% {
      transform: none;
    }
  }

  /* Variants */
  .btn--primary:hover {
    --bg: var(--brand-600);
  }

  .btn--accent {
    --bg: var(--accent);
    --fg: var(--slate-900);
    --line: rgb(15 23 42 / 0.2);
    --key-hover-bg: var(--slate-900);
    --key-hover-fg: var(--accent);
  }

  .btn--accent:hover {
    --bg: #fbad2b;
  }

  .btn--secondary {
    --bg: var(--surface);
    --fg: var(--text);
    --bd: var(--rule-strong);
    --line: var(--rule-strong);
    --key-hover-bg: var(--brand);
    --key-hover-fg: #fff;
  }

  .btn--secondary:hover {
    box-shadow: var(--shadow-hard);
    transform: translate(-2px, -2px);
  }

  .btn--light {
    --bg: #fff;
    --fg: var(--brand);
    --line: rgb(17 30 115 / 0.15);
  }

  .btn--outline-light {
    --bg: transparent;
    --fg: #fff;
    --bd: rgb(255 255 255 / 0.4);
    --line: rgb(255 255 255 / 0.4);
  }

  .btn--outline-light:hover {
    --bg: rgb(255 255 255 / 0.08);
  }

  /* Text link with an underline that draws in */
  .btn--link {
    --h: auto;
    background: none;
    color: var(--brand);
    border: 0;
    border-radius: 0;
    overflow: visible;
  }

  .btn--link .btn__label {
    padding: 0.25rem 0;
    background: linear-gradient(currentColor, currentColor) left bottom / 0% 1.5px no-repeat;
    transition: background-size 0.35s var(--ease);
  }

  .btn--link:hover .btn__label {
    background-size: 100% 1.5px;
  }

  .btn--link .btn__key {
    width: auto;
    padding-left: 0.4rem;
    border: 0;
    background: none !important;
    color: inherit !important;
  }
</style>
