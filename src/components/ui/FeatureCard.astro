---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  icon: IconName;
  title: string;
  body: string;
  tone?: 'default' | 'inverse';
  index?: number;
}

const { icon, title, body, tone = 'default', index = 0 } = Astro.props;
---

<article class:list={['card', `card--${tone}`]} data-reveal style={`--reveal-i:${index % 4}`}>
  <span class="card__icon"><Icon name={icon} size={22} /></span>
  <h3 class="card__title">{title}</h3>
  <p class="card__body">{body}</p>
</article>

<style>
  .card {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    height: 100%;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease),
      opacity var(--dur) var(--ease);
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--brand-tint-2);
    box-shadow: var(--shadow);
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 0.5rem;
    border-radius: 14px;
    background: var(--brand-tint);
    color: var(--brand);
    transition: transform 0.4s var(--ease);
  }

  .card:hover .card__icon {
    transform: scale(1.06) rotate(-4deg);
  }

  .card__title {
    font-size: 1.125rem;
    letter-spacing: -0.015em;
  }

  .card__body {
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .card--inverse {
    background: rgb(255 255 255 / 0.04);
    border-color: rgb(255 255 255 / 0.1);
  }

  .card--inverse:hover {
    background: rgb(255 255 255 / 0.07);
    border-color: rgb(255 255 255 / 0.18);
    box-shadow: none;
  }

  .card--inverse .card__icon {
    background: rgb(245 158 11 / 0.14);
    color: var(--accent);
  }

  .card--inverse .card__title {
    color: #fff;
  }

  .card--inverse .card__body {
    color: rgb(255 255 255 / 0.68);
  }
</style>
