---
import type { Faq } from '@/data/faqs';

interface Props {
  items: Faq[];
  /** Name shared by the <details> elements so only one stays open. */
  group?: string;
}

const { items, group = 'faq' } = Astro.props;
---

<div class="faq">
  {
    items.map((item, i) => (
      <details class="faq__item" name={group} data-reveal style={`--reveal-i:${i % 4}`}>
        <summary class="faq__q">
          <span class="faq__n">Q.{String(i + 1).padStart(2, '0')}</span>
          <span class="faq__text">{item.q}</span>
          <span class="faq__toggle" aria-hidden="true" />
        </summary>
        <div class="faq__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1.5px solid var(--rule-strong);
    interpolate-size: allow-keywords;
  }

  .faq__item {
    border-bottom: 1px solid var(--rule);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .faq__q {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) 28px;
    align-items: center;
    gap: 0.75rem;
    padding: 1.35rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__n {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 700;
    color: var(--text-3);
    transition: color 0.25s var(--ease);
  }

  .faq__text {
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color 0.25s var(--ease);
  }

  .faq__q:hover .faq__text,
  .faq__item[open] .faq__text {
    color: var(--brand);
  }

  .faq__item[open] .faq__n {
    color: var(--accent-700);
  }

  /* Plus that turns into a cross */
  .faq__toggle {
    position: relative;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border: 1.5px solid var(--rule-strong);
    transition:
      transform 0.4s var(--ease),
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .faq__toggle::before,
  .faq__toggle::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: var(--text);
    translate: -50% -50%;
    transition: background-color 0.25s;
  }

  .faq__toggle::after {
    rotate: 90deg;
  }

  .faq__item[open] .faq__toggle {
    transform: rotate(45deg);
    background: var(--accent);
    border-color: var(--accent);
  }

  /* Smooth height where supported; instant elsewhere. */
  .faq__item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s var(--ease),
      content-visibility 0.45s allow-discrete;
  }

  .faq__item[open]::details-content {
    block-size: auto;
  }

  .faq__a p {
    max-width: 62ch;
    padding: 0 2.5rem 1.5rem 4rem;
    color: var(--text-2);
    font-size: var(--fs-md);
    line-height: 1.7;
  }

  @media (max-width: 559px) {
    .faq__q {
      grid-template-columns: minmax(0, 1fr) 28px;
    }

    .faq__n {
      display: none;
    }

    .faq__text {
      font-size: var(--fs-md);
    }

    .faq__a p {
      padding: 0 0 1.4rem;
    }
  }
</style>
