---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** Omit src/alt to render custom content (the default slot) inside the screen. */
  src?: ImageMetadata;
  alt?: string;
  /** Rendered width hint for the responsive image set. */
  width?: number;
  eager?: boolean;
  class?: string;
}

const { src, alt, width = 300, eager = false, class: className } = Astro.props;
---

<div class:list={['phone', className]}>
  <div class="phone__screen">
    {
      src ? (
        <Image
          src={src}
          alt={alt ?? ''}
          widths={[width, Math.min(width * 2, src.width)]}
          sizes={`${width}px`}
          format="webp"
          quality={82}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
        />
      ) : (
        <slot />
      )
    }
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: 100%;
    aspect-ratio: 493 / 1071;
    padding: 3.2%;
    border-radius: 13% / 6%;
    background: linear-gradient(145deg, #1e293b, #0b1120 60%, #1e293b);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.08),
      0 0 0 1px rgb(15 23 42 / 0.6),
      var(--shadow-lg);
  }

  .phone::before {
    /* camera */
    content: '';
    position: absolute;
    top: 2.4%;
    left: 50%;
    width: 4.5%;
    aspect-ratio: 1;
    border-radius: 50%;
    translate: -50% 0;
    background: #020617;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    z-index: 2;
  }

  .phone__screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 10.5% / 4.9%;
    background: var(--slate-50);
  }

  .phone__screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
