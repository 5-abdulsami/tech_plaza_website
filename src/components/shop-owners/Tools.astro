---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PhoneFrame from '@/components/ui/PhoneFrame.astro';
import Icon from '@/components/ui/Icon.astro';
import dashboard from '@/assets/screens/owner-dashboard.png';
import products from '@/assets/screens/owner-products.png';
import addProduct from '@/assets/screens/add-product.png';

const rows = [
  {
    key: 'Dashboard',
    title: 'Your shop at a glance',
    body: 'Open the app and see how many listings are live, which chats are waiting, your rating and how many people follow you.',
    points: ['Live listings, unread chats, rating and followers', 'Recent products with a live/hidden switch', '“View as customer” to see your shop the way buyers do'],
    screen: dashboard,
    alt: 'Dashboard showing 4 live products, 0 unread chats, a 4.3 rating and 7 followers',
  },
  {
    key: 'Listings',
    title: 'Add a product in a minute',
    body: 'Take photos with your phone, add a price and a short description, and submit. We compress the photos so they load fast for customers.',
    points: ['Up to 5 photos, the first one is the cover', 'Negotiable or fixed price', 'Pick a category so buyers can find it'],
    screen: addProduct,
    alt: 'Add product form with photos, name, category, price and description',
  },
  {
    key: 'Inventory',
    title: 'Keep your stock up to date',
    body: 'Sold the last one? Switch the listing off. Back in stock? Switch it on again. Your listing count is always shown, so there are no surprises.',
    points: ['One-tap live or hidden', 'Filter by live, hidden or awaiting approval', 'Edit price and details at any time'],
    screen: products,
    alt: 'My products screen with four live listings and their toggles',
  },
];
---

<section class="section tools" aria-labelledby="tools-title">
  <div class="container">
    <SectionHeading
      index="02"
      label="Built for shopkeepers"
      id="tools-title"
      title="Simple tools that <span class='mark'>fit in your pocket.</span>"
      lead="No laptop or website needed. If you can use WhatsApp, you can run your Tech Plaza shop."
      tone="inverse"
    />

    <div class="tools__grid" data-tools>
      <!-- Desktop: one sticky phone whose screen follows the text -->
      <div class="tools__stick" aria-hidden="true">
        <PhoneFrame class="tools__phone">
          <div class="tools__screens">
            {
              rows.map((row, i) => (
                <Image
                  src={row.screen}
                  alt=""
                  widths={[300, 600]}
                  sizes="300px"
                  format="webp"
                  quality={82}
                  class:list={['tools__screen', { 'is-active': i === 0 }]}
                  data-tool-screen={i}
                />
              ))
            }
          </div>
        </PhoneFrame>
      </div>

      <ol role="list" class="tools__list">
        {
          rows.map((row, i) => (
            <li class:list={['tool', { 'is-active': i === 0 }]} data-tool={i}>
              <div class="tool__inline">
                <PhoneFrame src={row.screen} alt={row.alt} width={260} />
              </div>
              <p class="label tool__key">
                <span>{String.fromCharCode(65 + i)}</span>
                {row.key}
              </p>
              <h3>{row.title}</h3>
              <p class="tool__body">{row.body}</p>
              <ul role="list" class="tool__points">
                {row.points.map((p) => (
                  <li>
                    <Icon name="check" size={14} strokeWidth={3} />
                    {p}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  // Switch the sticky phone's screen to match the block in the middle of the viewport.
  document.querySelectorAll<HTMLElement>('[data-tools]').forEach((root) => {
    const blocks = [...root.querySelectorAll<HTMLElement>('[data-tool]')];
    const screens = [...root.querySelectorAll<HTMLElement>('[data-tool-screen]')];
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const i = Number((entry.target as HTMLElement).dataset.tool);
          blocks.forEach((b, j) => b.classList.toggle('is-active', j === i));
          screens.forEach((s, j) => s.classList.toggle('is-active', j === i));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    blocks.forEach((b) => observer.observe(b));
  });
</script>

<style>
  .tools {
    color: #fff;
    background: var(--brand-900);
  }

  .tools__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 1rem + 5vw, 6rem);
  }

  .tools__stick {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    align-self: start;
    display: grid;
    place-items: center;
    padding-block: 1rem;
  }

  .tools__stick :global(.tools__phone) {
    width: min(300px, 100%);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7);
  }

  .tools__screens {
    position: absolute;
    inset: 0;
  }

  .tools__screens :global(.tools__screen) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(4%);
    transition:
      opacity 0.5s var(--ease),
      transform 0.7s var(--ease);
  }

  .tools__screens :global(.tools__screen.is-active) {
    opacity: 1;
    transform: none;
  }

  .tools__list {
    display: grid;
  }

  .tool {
    display: grid;
    align-content: center;
    gap: 1rem;
    min-height: 62vh;
    padding-block: 3rem;
    border-top: 1px solid var(--rule-inverse);
    opacity: 0.35;
    transition: opacity 0.5s var(--ease);
  }

  .tool.is-active {
    opacity: 1;
  }

  .tool__inline {
    display: none;
  }

  .tool__key {
    color: rgb(255 255 255 / 0.6);
  }

  .tool__key span {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 4px;
    background: var(--accent);
    color: var(--slate-900);
  }

  .tool h3 {
    font-size: var(--fs-xl);
  }

  .tool__body {
    max-width: 32rem;
    font-size: var(--fs-lg);
    color: rgb(255 255 255 / 0.72);
  }

  .tool__points {
    display: grid;
    gap: 0.7rem;
    margin-top: 0.5rem;
  }

  .tool__points li {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .tool__points :global(svg) {
    flex: none;
    color: var(--accent);
  }

  @media (max-width: 859px) {
    .tools__grid {
      grid-template-columns: 1fr;
    }

    .tools__stick {
      display: none;
    }

    .tool {
      min-height: 0;
      opacity: 1;
    }

    .tool__inline {
      display: grid;
      justify-items: center;
      margin-bottom: 1.5rem;
    }

    .tool__inline :global(.phone) {
      width: min(260px, 70vw);
    }
  }
</style>
