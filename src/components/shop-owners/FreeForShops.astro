---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';

const included: { icon: IconName; title: string; body: string }[] = [
  { icon: 'store', title: 'Shop page', body: 'Logo, location, description and every product.' },
  { icon: 'image-plus', title: 'Product listings', body: 'Add, edit, hide and relist in one tap.' },
  { icon: 'messages', title: 'Customer chat', body: 'Real-time messages with push notifications.' },
  { icon: 'star', title: 'Ratings & followers', body: 'A reputation customers can see.' },
];
---

<section id="free" class="section free" aria-labelledby="free-title">
  <div class="container">
    <div class="free__card" data-reveal="scale">
      <SectionHeading
        id="free-title"
        eyebrow="Pricing"
        title="Free. <em>Completely.</em>"
        lead="No listing fees, no commission on your sales, no card needed. Just a real shop and your CNIC."
        tone="inverse"
      />

      <ul role="list" class="free__grid">
        {
          included.map((item, i) => (
            <li data-reveal style={`--reveal-i:${i}`}>
              <span class="free__icon">
                <Icon name={item.icon} size={20} />
              </span>
              <strong>{item.title}</strong>
              <span>{item.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .free__card {
    position: relative;
    overflow: hidden;
    padding: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) clamp(1.25rem, 1rem + 3vw, 4rem);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, var(--brand), var(--brand-900));
    box-shadow: var(--shadow-lg);
    isolation: isolate;
  }

  .free__card::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -30%;
    right: -10%;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(245 158 11 / 0.22), transparent 65%);
  }

  .free__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .free__grid li {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.1);
    color: rgb(255 255 255 / 0.68);
    font-size: var(--fs-sm);
    transition:
      background-color 0.4s var(--ease),
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .free__grid li:hover {
    background: rgb(255 255 255 / 0.09);
  }

  .free__grid strong {
    color: #fff;
    font-size: 1.0625rem;
  }

  .free__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 0.5rem;
    border-radius: 12px;
    background: rgb(245 158 11 / 0.15);
    color: var(--accent);
  }

  @media (max-width: 959px) {
    .free__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 479px) {
    .free__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
