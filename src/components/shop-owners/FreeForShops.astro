---
import PriceTag from '@/components/ui/PriceTag.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';

const included: { icon: IconName; title: string; body: string }[] = [
  { icon: 'store', title: 'Shop page', body: 'Logo, location, description and every product.' },
  { icon: 'image-plus', title: 'Product listings', body: 'Add, edit, hide and relist in one tap.' },
  { icon: 'messages', title: 'Customer chat', body: 'Real-time messages with push notifications.' },
  { icon: 'star', title: 'Ratings & followers', body: 'A reputation customers can see.' },
];
---

<section id="free" class="section free" aria-labelledby="free-title">
  <div class="container free__grid">
    <div class="free__tag" data-reveal="fade">
      <PriceTag eyebrow="Price for shops" value="Rs 0" note="No fees · No commission" tilt={-5} size="lg" />
    </div>

    <div class="free__copy">
      <p class="label" data-reveal="fade"><span class="free__idx">03</span> Pricing</p>
      <h2 id="free-title" class="free__title" data-reveal="wipe">Free. <span class="mark">Completely.</span></h2>
      <p class="lead" data-reveal style="--reveal-i:2">
        No listing fees, no commission on your sales, no card needed. Just a real shop and your CNIC.
      </p>

      <ul role="list" class="free__list">
        {
          included.map((item, i) => (
            <li data-reveal style={`--reveal-i:${i}`}>
              <span class="free__check">
                <Icon name="check" size={14} strokeWidth={3} />
              </span>
              <span>
                <strong>{item.title}</strong>
                {item.body}
              </span>
              <span class="free__price">Rs 0</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .free__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: center;
  }

  .free__tag {
    display: grid;
    place-items: center;
  }

  .free__copy {
    display: grid;
    gap: 1.25rem;
  }

  .free__idx {
    display: inline-grid;
    place-items: center;
    min-width: 2.2rem;
    height: 1.6rem;
    border: 1.5px solid currentColor;
    border-radius: 4px;
    color: var(--brand);
  }

  .free__title {
    font-size: var(--fs-2xl);
    font-weight: 800;
  }

  /* Itemised like a bill where every line costs nothing */
  .free__list {
    margin-top: 1rem;
    border-top: 1.5px solid var(--rule-strong);
  }

  .free__list li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .free__list strong {
    display: block;
    color: var(--text);
    font-size: var(--fs-md);
  }

  .free__check {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--brand);
    color: #fff;
  }

  .free__price {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--success);
  }

  @media (max-width: 859px) {
    .free__grid {
      grid-template-columns: 1fr;
    }

  }
</style>
