---
import PhoneFrame from '@/components/ui/PhoneFrame.astro';
import StoreButton from '@/components/ui/StoreButton.astro';
import Button from '@/components/ui/Button.astro';
import PriceTag from '@/components/ui/PriceTag.astro';
import Stamp from '@/components/ui/Stamp.astro';
import dashboard from '@/assets/screens/owner-dashboard.png';
import shop from '@/assets/screens/shop-profile.png';
import { site } from '@/config/site';

const stats = [
  { value: 'Rs 0', label: 'Listing fee' },
  { value: '0%', label: 'Commission' },
  { value: 'Up to 5', label: 'Photos per product' },
];
---

<section class="ohero" aria-labelledby="ohero-title">
  <div class="container ohero__grid">
    <div class="ohero__copy">
      <p class="label" data-reveal="fade">
        <a href="/">techplaza.app</a>
        <span aria-hidden="true">/</span>
        <span class="ohero__here">For shop owners</span>
      </p>
      <h1 id="ohero-title" class="ohero__title" data-reveal="wipe" style="--reveal-i:1">
        Put your shop in every <span class="mark">customer’s pocket.</span>
      </h1>
      <p class="lead" data-reveal style="--reveal-i:2">
        Tech Plaza gives your plaza shop a storefront customers can browse from home. They see your products and
        prices, message you with questions, and walk in ready to buy.
      </p>
      <div class="ohero__actions" data-reveal style="--reveal-i:3">
        <StoreButton />
        <Button
          href={`mailto:${site.contact.email}?subject=List%20my%20shop%20on%20Tech%20Plaza`}
          variant="secondary"
          size="lg"
          iconStart="mail"
        >
          Talk to us
        </Button>
      </div>
      <dl class="ohero__stats" data-reveal style="--reveal-i:4">
        {
          stats.map((s) => (
            <div>
              <dt class="label">{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="ohero__visual" data-reveal="fade" style="--reveal-i:2">
      <span class="ohero__slab" aria-hidden="true"></span>
      <PhoneFrame src={shop} alt="A shop page as customers see it" width={260} eager class="ohero__phone ohero__phone--back" />
      <PhoneFrame src={dashboard} alt="Shop owner dashboard" width={290} eager class="ohero__phone ohero__phone--front" />
      <PriceTag class="ohero__tag" eyebrow="Listing fee" value="Rs 0" note="Free for shops" tilt={8} />
      <Stamp class="ohero__stamp" text="Shop approved • Ready for customers • " icon="badge-check" size={128} />
    </div>
  </div>
</section>

<style>
  .ohero {
    padding: clamp(2.5rem, 1.5rem + 4vw, 5rem) 0 clamp(4rem, 2rem + 5vw, 6.5rem);
    border-bottom: 1.5px solid var(--rule-strong);
  }

  .ohero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .ohero__copy {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .ohero__copy .label a:hover {
    color: var(--brand);
  }

  .ohero__here {
    color: var(--brand);
  }

  .ohero__title {
    font-size: clamp(2.75rem, 1.6rem + 4.4vw, 5.5rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.045em;
    color: var(--brand);
  }

  .ohero__title .mark {
    color: var(--slate-900);
  }

  .ohero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .ohero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    max-width: 34rem;
    margin-top: 0.5rem;
    border-top: 1.5px solid var(--rule-strong);
  }

  .ohero__stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.3rem;
    padding: 1rem 1rem 0 0;
  }

  .ohero__stats div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .ohero__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--brand);
  }

  /* Visual */
  .ohero__visual {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1 / 1.12;
    margin-inline: auto;
  }

  .ohero__slab {
    position: absolute;
    inset: 14% 4% 6% 10%;
    border-radius: var(--radius-xl);
    background: var(--accent);
    background-image: repeating-linear-gradient(-45deg, rgb(15 23 42 / 0.06) 0 2px, transparent 2px 14px);
  }

  .ohero__visual :global(.ohero__phone) {
    position: absolute;
    box-shadow: var(--shadow-lg);
  }

  .ohero__visual :global(.ohero__phone--front) {
    width: 54%;
    left: 8%;
    top: 0;
    z-index: 1;
    rotate: -4deg;
  }

  .ohero__visual :global(.ohero__phone--back) {
    width: 48%;
    right: 2%;
    top: 10%;
    rotate: 5deg;
  }

  .ohero__visual :global(.ohero__tag) {
    position: absolute;
    z-index: 2;
    right: -2%;
    top: -6%;
  }

  .ohero__visual :global(.ohero__stamp) {
    position: absolute;
    z-index: 2;
    left: -9%;
    bottom: -3%;
    background: var(--bg);
    border-radius: 50%;
  }

  @media (max-width: 959px) {
    .ohero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .ohero__visual {
      width: min(100%, 400px);
    }
  }

  @media (max-width: 479px) {
    .ohero__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .ohero__actions :global(.btn__label) {
      flex: 1;
      justify-content: center;
    }

    .ohero__stats dd {
      font-size: 1.35rem;
    }

    .ohero__visual :global(.ohero__tag) {
      right: 0;
    }

    .ohero__visual :global(.ohero__stamp) {
      display: none;
    }
  }
</style>
