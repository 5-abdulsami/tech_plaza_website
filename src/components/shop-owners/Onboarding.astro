---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { onboarding } from '@/data/owners';

const statuses = [
  { tag: 'Pending', tone: 'pending', body: 'We’re reviewing your shop.' },
  { tag: 'Needs changes', tone: 'rejected', body: 'We tell you what to fix, and you resubmit.' },
  { tag: 'Active', tone: 'active', body: 'Your dashboard opens and you can start listing.' },
];
---

<section id="onboarding" class="section onb" aria-labelledby="onb-title">
  <div class="container">
    <SectionHeading
      index="01"
      label="Getting started"
      id="onb-title"
      title="From sign-up to your <span class='mark'>first customer.</span>"
      lead="Everything happens in the app. We review each shop by hand so customers can trust every listing, including yours."
    />

    <ol role="list" class="steps">
      {
        onboarding.map((step, i) => (
          <li data-reveal style={`--reveal-i:${i}`}>
            <span class="steps__num" aria-hidden="true">
              {i + 1}
            </span>
            <span class="label steps__key">
              <Icon name={step.icon} size={15} />
              Step {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="status" data-reveal>
      <p class="label status__title">Your shop status, always visible in the app</p>
      <ul role="list">
        {
          statuses.map((s) => (
            <li>
              <span class:list={['status__tag', `status__tag--${s.tone}`]}>{s.tag}</span>
              <span>{s.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1.5px solid var(--rule-strong);
  }

  .steps li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem 1.25rem 1.5rem 0;
  }

  .steps li + li {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }

  /* Big outlined floor numbers */
  .steps__num {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--brand);
    transition: color 0.35s var(--ease);
  }

  .steps li:hover .steps__num {
    color: var(--accent);
    -webkit-text-stroke-color: var(--accent);
  }

  .steps__key {
    color: var(--brand);
    margin-top: 0.5rem;
  }

  .steps h3 {
    font-size: 1.1875rem;
  }

  .steps p {
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .status {
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    border: 1.5px solid var(--rule-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .status__title {
    padding: 0.85rem 1.25rem;
    background: var(--slate-900);
    color: #fff;
  }

  .status ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .status li {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 0.6rem;
    padding: 1.25rem;
    font-size: var(--fs-sm);
    color: var(--text-2);
    background: var(--surface);
  }

  .status li + li {
    border-left: 1px solid var(--rule);
  }

  .status__tag {
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .status__tag--pending {
    background: var(--accent-tint);
    color: #854d0e;
  }

  .status__tag--rejected {
    background: var(--danger-bg);
    color: var(--danger);
  }

  .status__tag--active {
    background: var(--success-bg);
    color: var(--success);
  }

  @media (max-width: 1023px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .steps li,
    .steps li + li {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      column-gap: 1.25rem;
      padding: 1.25rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }

    .steps__num {
      grid-row: span 3;
      font-size: 3.5rem;
    }

    .steps__key {
      margin-top: 0;
    }
  }

  @media (max-width: 719px) {
    .status ul {
      grid-template-columns: 1fr;
    }

    .status li + li {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
