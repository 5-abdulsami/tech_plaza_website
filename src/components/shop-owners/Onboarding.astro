---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { onboarding } from '@/data/owners';
---

<section id="onboarding" class="section onb" aria-labelledby="onb-title">
  <div class="container">
    <SectionHeading
      id="onb-title"
      eyebrow="Getting started"
      title="From sign-up to <em>first customer</em>"
      lead="Everything happens in the app. We review each shop by hand so customers can trust every listing, including yours."
    />

    <ol class="onb__list" role="list">
      {
        onboarding.map((step, i) => (
          <li class="onb__item" data-reveal style={`--reveal-i:${i}`}>
            <span class="onb__icon">
              <Icon name={step.icon} size={22} />
            </span>
            <span class="onb__num">Step {i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="onb__status" data-reveal>
      <h3>You always know where you stand</h3>
      <ul role="list">
        <li><span class="pill pill--pending">Pending</span> We’re reviewing your shop.</li>
        <li><span class="pill pill--rejected">Needs changes</span> We tell you what to fix, and you resubmit.</li>
        <li><span class="pill pill--active">Active</span> Your dashboard opens and you can start listing.</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .onb {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }

  .onb__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    counter-reset: step;
  }

  .onb__list::before {
    content: '';
    position: absolute;
    top: 28px;
    left: 10%;
    right: 10%;
    border-top: 2px dashed var(--slate-200);
  }

  .onb__item {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.5rem;
    text-align: center;
  }

  .onb__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 0.75rem;
    border-radius: 18px;
    background: var(--brand);
    color: #fff;
    box-shadow: 0 0 0 6px var(--surface), 0 12px 24px -10px rgb(17 30 115 / 0.5);
    transition: transform 0.4s var(--ease);
  }

  .onb__item:hover .onb__icon {
    transform: translateY(-4px) rotate(-4deg);
  }

  .onb__num {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-700);
  }

  .onb__item h3 {
    font-size: 1.0625rem;
  }

  .onb__item p {
    max-width: 16rem;
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .onb__status {
    display: grid;
    gap: 1.25rem;
    max-width: 860px;
    margin: clamp(3rem, 2rem + 3vw, 4.5rem) auto 0;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--bg);
    border: 1px solid var(--border);
  }

  .onb__status h3 {
    font-size: var(--fs-lg);
    text-align: center;
  }

  .onb__status ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .onb__status li {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .pill {
    justify-self: start;
    line-height: 1.5;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .pill--pending {
    background: var(--accent-tint);
    color: #854d0e;
  }

  .pill--rejected {
    background: var(--danger-bg);
    color: var(--danger);
  }

  .pill--active {
    background: var(--success-bg);
    color: var(--success);
  }

  @media (max-width: 959px) {
    .onb__list {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      max-width: 30rem;
      margin-inline: auto;
    }

    .onb__list::before {
      top: 28px;
      bottom: 28px;
      left: 27px;
      right: auto;
      border-top: 0;
      border-left: 2px dashed var(--slate-200);
    }

    .onb__item {
      grid-template-columns: 56px 1fr;
      column-gap: 1.25rem;
      justify-items: start;
      text-align: left;
    }

    .onb__icon {
      grid-row: span 3;
      margin-bottom: 0;
    }

    .onb__item p {
      max-width: none;
    }
  }

  @media (max-width: 639px) {
    .onb__status ul {
      grid-template-columns: 1fr;
    }
  }
</style>
