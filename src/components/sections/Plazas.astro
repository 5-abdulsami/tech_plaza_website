---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { categories, plazas } from '@/data/plazas';
import { site } from '@/config/site';
---

<section id="plazas" class="section plazas" aria-labelledby="plazas-title">
  <div class="container">
    <SectionHeading
      id="plazas-title"
      eyebrow={`Plazas in ${site.city}`}
      title="The places you already shop, <em>in one app</em>"
      lead="Browse one plaza or all of them at once. We’re starting in Dubai Plaza and adding shops across the city."
    />

    <ul class="plazas__grid" role="list">
      {
        plazas.map((p, i) => (
          <li class:list={['plaza', { 'plaza--launch': p.launch }]} data-reveal style={`--reveal-i:${i % 3}`}>
            <span class="plaza__icon">
              <Icon name="store" size={22} />
            </span>
            <span class="plaza__text">
              <strong>{p.name}</strong>
              <span>
                <Icon name="map-pin" size={14} /> {p.area}, {site.city}
              </span>
            </span>
            {p.launch && <span class="plaza__badge">Launching first</span>}
          </li>
        ))
      }
    </ul>

    <div class="plazas__cats" data-reveal>
      <p>Shop by category</p>
      <ul role="list">
        {categories.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .plazas__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .plaza {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease),
      opacity var(--dur) var(--ease);
  }

  .plaza:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--brand-tint-2);
  }

  .plaza--launch {
    border-color: rgb(245 158 11 / 0.5);
    background: linear-gradient(135deg, #fff, #fffbeb);
  }

  .plaza__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--brand-tint);
    color: var(--brand);
  }

  .plaza--launch .plaza__icon {
    background: var(--accent-tint);
    color: var(--accent-700);
  }

  .plaza__text {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .plaza__text strong {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .plaza__text span {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .plaza__text :global(svg) {
    flex: none;
  }

  .plaza__badge {
    position: absolute;
    top: -10px;
    right: 1rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--slate-900);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .plazas__cats {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .plazas__cats p {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .plazas__cats ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  .plazas__cats li {
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-2);
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast);
  }

  .plazas__cats li:hover {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }

  @media (max-width: 1023px) {
    .plazas__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 599px) {
    .plazas__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
