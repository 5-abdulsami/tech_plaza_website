---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { categories, plazas } from '@/data/plazas';
import { site } from '@/config/site';
---

<section id="plazas" class="section plazas" aria-labelledby="plazas-title">
  <div class="container">
    <SectionHeading
      index="06"
      label={`Plazas in ${site.city}`}
      id="plazas-title"
      title="The places you already shop, <span class='mark'>in one app.</span>"
      lead="Browse one plaza or all of them at once. We’re starting in Dubai Plaza and adding shops across the city."
    />

    <div class="board" data-reveal>
      <div class="board__top">
        <span class="board__lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>Directory · {site.city} tech plazas</span>
        <span class="board__count">{String(plazas.length).padStart(2, '0')}</span>
      </div>

      <table class="board__table">
        <caption class="visually-hidden">Plazas available in Tech Plaza</caption>
        <thead>
          <tr>
            <th scope="col">No.</th>
            <th scope="col">Plaza</th>
            <th scope="col" class="board__loc">Location</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {
            plazas.map((p, i) => (
              <tr class:list={{ 'is-launch': p.launch }}>
                <td class="board__no">{String(i + 1).padStart(2, '0')}</td>
                <th scope="row" class="board__name">
                  <span data-scramble data-scramble-delay={i * 120}>
                    {p.name}
                  </span>
                  <span class="board__sub">{p.area}</span>
                </th>
                <td class="board__loc">
                  {p.area}, {site.city}
                </td>
                <td class="board__status">
                  {p.launch ? (
                    <span class="status status--launch">
                      <i aria-hidden="true" />
                      Launching first
                    </span>
                  ) : (
                    <span class="status">In the app</span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="cats" data-reveal>
      <p class="label">Shop by category</p>
      <ul role="list">
        {categories.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  import { initScramble } from '@/scripts/scramble';
  initScramble();
</script>

<style>
  /* A backlit plaza directory board */
  .board {
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--brand-900);
    color: #fff;
    box-shadow:
      inset 0 0 0 6px var(--slate-800),
      inset 0 0 0 7px rgb(255 255 255 / 0.06),
      var(--shadow-lg);
    padding: 6px;
  }

  .board__top {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--rule-inverse);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.65);
  }

  .board__lights {
    display: inline-flex;
    gap: 5px;
  }

  .board__lights i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: blink 2.4s steps(1) infinite;
  }

  .board__lights i:nth-child(2) {
    animation-delay: 0.8s;
  }

  .board__lights i:nth-child(3) {
    animation-delay: 1.6s;
  }

  .board__count {
    margin-left: auto;
    padding: 0.15rem 0.5rem;
    border: 1px solid rgb(245 158 11 / 0.5);
    border-radius: 4px;
    color: var(--accent);
  }

  .board__table {
    width: 100%;
    border-collapse: collapse;
  }

  .board__table th,
  .board__table td {
    padding: 1.15rem 1.5rem;
    text-align: left;
    border-bottom: 1px solid var(--rule-inverse);
  }

  .board__table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .board__table thead th {
    padding-block: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.4);
  }

  .board__table tbody tr {
    transition: background-color 0.25s var(--ease);
  }

  .board__table tbody tr:hover {
    background: rgb(255 255 255 / 0.04);
  }

  .board__no {
    width: 4.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--accent);
  }

  .board__name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .board__name span {
    display: inline-block;
  }

  .board__sub {
    display: none !important;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0;
    color: rgb(255 255 255 / 0.55);
  }

  .board__loc {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: rgb(255 255 255 / 0.55);
  }

  .board__status {
    width: 1%;
    white-space: nowrap;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--rule-inverse);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
  }

  .status--launch {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--slate-900);
  }

  .status--launch i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--slate-900);
    animation: blink 1.2s steps(1) infinite;
  }

  /* Categories as small paper tags */
  .cats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.5rem;
  }

  .cats ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .cats li {
    position: relative;
    padding: 0.45rem 0.9rem 0.45rem 1.6rem;
    border: 1.5px solid var(--slate-900);
    border-radius: 4px 8px 8px 4px;
    background: var(--paper);
    font-size: var(--fs-sm);
    font-weight: 600;
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .cats li::before {
    content: '';
    position: absolute;
    left: 0.6rem;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    translate: 0 -50%;
    box-shadow: inset 0 0 0 1.5px var(--slate-900);
  }

  .cats li:hover {
    transform: translate(-2px, -2px) rotate(-2deg);
    box-shadow: 3px 3px 0 var(--accent);
  }

  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  @media (max-width: 719px) {
    .board__loc {
      display: none;
    }

    .board__table th,
    .board__table td {
      padding: 1rem 0.9rem;
    }

    .board__no {
      width: 2.5rem;
    }

    .board__name {
      white-space: normal;
      font-size: 1.125rem;
    }

    .board__sub {
      display: block !important;
      margin-top: 0.2rem;
    }
  }

  @media (max-width: 419px) {
    .status {
      padding: 0.25rem 0.45rem;
      font-size: 0.5625rem;
      letter-spacing: 0.04em;
    }
  }
</style>
