---
import { Image } from 'astro:assets';
import StoreButton from '@/components/ui/StoreButton.astro';
import Button from '@/components/ui/Button.astro';
import logo from '@/assets/brand/logo.png';
import { site } from '@/config/site';

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = 'Your next gadget is <span class="cta__u">closer</span> than you think.',
  lead = site.app.playStoreUrl
    ? 'Download Tech Plaza for Android and see what’s in stock across Rawalpindi’s tech plazas.'
    : 'Tech Plaza is coming soon to Google Play. Shop owners can get in touch now to be listed from day one.',
} = Astro.props;
---

<section id="download" class="cta" aria-labelledby="download-title">
  <div class="container cta__grid">
    <div class="cta__copy">
      <p class="label cta__label" data-reveal="fade">Admit one · Free entry</p>
      <h2 id="download-title" class="cta__title" data-reveal="wipe" set:html={title} />
      <p class="cta__lead" data-reveal style="--reveal-i:2">{lead}</p>
    </div>

    <div class="cta__side" data-reveal style="--reveal-i:2">
      <Image src={logo} alt="" width={96} height={96} widths={[96, 192]} sizes="96px" format="webp" class="cta__logo" />
      <StoreButton />
      {
        !site.app.playStoreUrl && (
          <Button href={`mailto:${site.contact.email}?subject=List%20my%20shop%20on%20Tech%20Plaza`} variant="secondary" size="lg" iconStart="mail">
            List my shop
          </Button>
        )
      }
    </div>
  </div>
</section>

<style>
  /* Amber band with perforated edges, like a ticket stub */
  .cta {
    --hole: 9px;
    position: relative;
    padding-block: clamp(4rem, 3rem + 5vw, 7rem);
    background: var(--accent);
    color: var(--slate-900);
    mask:
      radial-gradient(var(--hole) at 50% 0, #0000 98%, #000) 50% 0 / calc(var(--hole) * 3.2) 51% repeat-x,
      radial-gradient(var(--hole) at 50% 100%, #0000 98%, #000) 50% 100% / calc(var(--hole) * 3.2) 51% repeat-x;
    -webkit-mask:
      radial-gradient(var(--hole) at 50% 0, #0000 98%, #000) 50% 0 / calc(var(--hole) * 3.2) 51% repeat-x,
      radial-gradient(var(--hole) at 50% 100%, #0000 98%, #000) 50% 100% / calc(var(--hole) * 3.2) 51% repeat-x;
  }

  .cta__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) auto;
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: end;
  }

  .cta__copy {
    display: grid;
    gap: 1.25rem;
  }

  .cta__label {
    color: rgb(15 23 42 / 0.7);
  }

  .cta__title {
    font-size: var(--fs-2xl);
    font-weight: 800;
    letter-spacing: -0.045em;
    max-width: 14ch;
  }

  .cta__title :global(.cta__u) {
    font-style: italic;
    font-variation-settings: 'wdth' 75;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.12em;
  }

  .cta__lead {
    max-width: 34rem;
    font-size: var(--fs-lg);
    color: rgb(15 23 42 / 0.78);
  }

  .cta__side {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding-left: clamp(0rem, 3vw, 3rem);
    border-left: 1.5px dashed rgb(15 23 42 / 0.35);
  }

  .cta__side :global(.cta__logo) {
    border-radius: 50%;
    box-shadow: 0 0 0 5px var(--slate-900);
    margin-bottom: 0.5rem;
    transition: transform 0.8s var(--ease);
  }

  .cta__side:hover :global(.cta__logo) {
    transform: rotate(-20deg);
  }

  .cta__side :global(.btn--secondary) {
    --bg: transparent;
  }

  @media (max-width: 859px) {
    .cta__grid {
      grid-template-columns: 1fr;
    }

    .cta__side {
      padding: 2rem 0 0;
      border-left: 0;
      border-top: 1.5px dashed rgb(15 23 42 / 0.35);
    }
  }
</style>
