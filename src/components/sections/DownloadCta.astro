---
import { Image } from 'astro:assets';
import StoreButton from '@/components/ui/StoreButton.astro';
import Button from '@/components/ui/Button.astro';
import logo from '@/assets/brand/logo.png';
import { site } from '@/config/site';

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = 'Your next gadget is closer than you think',
  lead = site.app.playStoreUrl
    ? 'Download Tech Plaza for Android and see what’s in stock across Rawalpindi’s tech plazas.'
    : 'Tech Plaza is coming soon to Google Play. Shop owners can get in touch now to be listed from day one.',
} = Astro.props;
---

<section id="download" class="cta-wrap" aria-labelledby="download-title">
  <div class="container">
    <div class="cta" data-reveal="scale">
      <div class="cta__rings" aria-hidden="true"><span></span><span></span><span></span></div>
      <Image src={logo} alt="" width={88} height={88} widths={[88, 176]} sizes="88px" format="webp" class="cta__logo" />
      <h2 id="download-title" class="cta__title">{title}</h2>
      <p class="cta__lead">{lead}</p>
      <div class="cta__actions">
        <StoreButton tone="light" />
        {
          !site.app.playStoreUrl && (
            <Button href={`mailto:${site.contact.email}?subject=List%20my%20shop%20on%20Tech%20Plaza`} variant="outline-light" size="lg" iconStart="mail">
              List my shop
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-block: 0 var(--section-y);
  }

  .cta {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding: clamp(3rem, 2rem + 5vw, 5.5rem) clamp(1.25rem, 1rem + 3vw, 4rem);
    overflow: hidden;
    border-radius: var(--radius-xl);
    text-align: center;
    color: #fff;
    /* Same gradient direction as the app's splash screen. */
    background: linear-gradient(165deg, var(--brand) 0%, var(--splash-deep) 100%);
    box-shadow: var(--shadow-lg);
    isolation: isolate;
  }

  .cta__rings {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    z-index: -1;
  }

  .cta__rings span {
    position: absolute;
    width: 30rem;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.08);
    animation: ripple 6s var(--ease) infinite;
  }

  .cta__rings span:nth-child(2) {
    animation-delay: -2s;
  }

  .cta__rings span:nth-child(3) {
    animation-delay: -4s;
  }

  .cta :global(.cta__logo) {
    border-radius: 50%;
    box-shadow: 0 0 0 8px rgb(255 255 255 / 0.06), 0 20px 40px -12px rgb(0 0 0 / 0.5);
  }

  .cta__title {
    max-width: 20ch;
    font-size: var(--fs-2xl);
  }

  .cta__lead {
    max-width: 36rem;
    color: rgb(255 255 255 / 0.75);
    font-size: var(--fs-lg);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 0.75rem;
  }

  @keyframes ripple {
    0% {
      transform: scale(0.4);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }
</style>
