---
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const before = [
  'Walk from shop to shop asking the same question',
  'No idea who has stock until you get there',
  'Prices change from counter to counter',
  'Hard to tell which shop to trust',
];

const after = [
  'See what every shop in the plaza is selling',
  'Ask about stock in chat before you leave home',
  'Compare prices side by side and sort them',
  'Verified shops with ratings from real buyers',
];
---

<section class="section compare" aria-labelledby="compare-title">
  <div class="container">
    <SectionHeading
      id="compare-title"
      eyebrow="Why Tech Plaza"
      title="Stop walking the plaza. <em>Start with your phone.</em>"
      lead="Buying electronics locally is still the best way to see what you are paying for. Finding it shouldn’t take a whole afternoon."
    />

    <div class="compare__grid">
      <article class="panel panel--before" data-reveal>
        <h3 class="panel__title">The usual way</h3>
        <ul role="list" class="panel__list">
          {
            before.map((t) => (
              <li>
                <span class="panel__mark">
                  <Icon name="x" size={14} strokeWidth={2.5} />
                </span>
                {t}
              </li>
            ))
          }
        </ul>
      </article>

      <article class="panel panel--after" data-reveal style="--reveal-i:1">
        <h3 class="panel__title">With Tech Plaza</h3>
        <ul role="list" class="panel__list">
          {
            after.map((t) => (
              <li>
                <span class="panel__mark">
                  <Icon name="check" size={14} strokeWidth={2.5} />
                </span>
                {t}
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .compare__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    max-width: 960px;
    margin-inline: auto;
  }

  .panel {
    padding: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    border-radius: var(--radius-xl);
  }

  .panel--before {
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .panel--after {
    position: relative;
    overflow: hidden;
    background: linear-gradient(150deg, var(--brand), var(--splash-deep));
    color: #fff;
    box-shadow: var(--shadow-lg);
  }

  .panel--after::after {
    content: '';
    position: absolute;
    right: -30%;
    top: -40%;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(245 158 11 / 0.25), transparent 65%);
  }

  .panel__title {
    margin-bottom: 1.5rem;
    font-size: var(--fs-lg);
  }

  .panel--before .panel__title {
    color: var(--text-2);
  }

  .panel__list {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.1rem;
  }

  .panel__list li {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  .panel--before li {
    color: var(--text-2);
  }

  .panel__mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    margin-top: -1px;
    border-radius: 50%;
  }

  .panel--before .panel__mark {
    background: var(--danger-bg);
    color: var(--danger);
  }

  .panel--after .panel__mark {
    background: var(--accent);
    color: var(--slate-900);
  }

  @media (max-width: 767px) {
    .compare__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
