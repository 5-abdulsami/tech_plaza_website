---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import FaqList from '@/components/ui/FaqList.astro';
import Button from '@/components/ui/Button.astro';
import type { Faq } from '@/data/faqs';

interface Props {
  items: Faq[];
  title?: string;
  eyebrow?: string;
  id?: string;
}

const { items, title = 'Questions, <em>answered</em>', eyebrow = 'FAQ', id = 'faq' } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="container-narrow">
    <SectionHeading id={`${id}-title`} eyebrow={eyebrow} title={title} />
    <FaqList items={items} group={id} />
    <div class="faq-more" data-reveal>
      <p>Still have a question?</p>
      <Button href="/help" variant="ghost" icon="arrow-right">Visit the help centre</Button>
    </div>
  </div>
</section>

<style>
  .faq-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 0.5rem;
    margin-top: 2rem;
    color: var(--text-2);
    font-size: var(--fs-sm);
  }
</style>
