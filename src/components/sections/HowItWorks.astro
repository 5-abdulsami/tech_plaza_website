---
import { Image } from 'astro:assets';
import PhoneFrame from '@/components/ui/PhoneFrame.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { journey } from '@/data/journey';
---

<section id="how-it-works" class="section how" aria-labelledby="how-title">
  <div class="container">
    <SectionHeading
      index="02"
      label="How it works"
      id="how-title"
      title="From search to the <span class='mark'>shop counter.</span>"
      lead="Tech Plaza doesn’t sell anything itself. It gets you to the right shop, already knowing the price."
      tone="inverse"
    />

    <div class="how__stage" data-journey>
      <div class="how__visual" data-reveal="fade">
        <PhoneFrame class="how__phone">
          <div class="how__screens">
            {
              journey.map((step, i) => (
                <Image
                  src={step.screen}
                  alt={step.alt}
                  widths={[320, 640]}
                  sizes="320px"
                  format="webp"
                  quality={82}
                  class:list={['how__screen', { 'is-active': i === 0 }]}
                  data-screen={i}
                />
              ))
            }
          </div>
        </PhoneFrame>
      </div>

      <div class="how__panel">
        <div class="how__texts">
        {
          journey.map((step, i) => (
            <div
              class:list={['how__text', { 'is-active': i === 0 }]}
              id={`step-panel-${i}`}
              role="tabpanel"
              aria-labelledby={`step-tab-${i}`}
              data-panel={i}
            >
              <span class="how__big" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          ))
        }
        </div>

        <div class="rail" role="tablist" aria-label="Steps">
          {
            journey.map((step, i) => (
              <button
                class="rail__step"
                type="button"
                role="tab"
                id={`step-tab-${i}`}
                aria-controls={`step-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-step={i}
              >
                <span class="rail__bar" aria-hidden="true">
                  <span />
                </span>
                <span class="rail__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="rail__title">
                  <Icon name={step.icon} size={16} />
                  {step.title}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const INTERVAL = 5500;

  document.querySelectorAll<HTMLElement>('[data-journey]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const screens = [...root.querySelectorAll<HTMLElement>('[data-screen]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let timer: number | undefined;
    let stopped = reduced; // autoplay stops for good once the visitor picks a step
    let hovering = false;
    let visible = false;

    const clear = () => {
      window.clearTimeout(timer);
      tabs[index].classList.remove('is-running');
    };

    const schedule = () => {
      clear();
      if (stopped || hovering || !visible) return;
      const tab = tabs[index];
      void tab.offsetWidth; // restart the progress bar animation
      tab.classList.add('is-running');
      timer = window.setTimeout(() => select(index + 1), INTERVAL);
    };

    const select = (next: number, focus = false) => {
      clear();
      index = (next + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      screens.forEach((s, i) => s.classList.toggle('is-active', i === index));
      panels.forEach((p, i) => p.classList.toggle('is-active', i === index));
      if (focus) tabs[index].focus();
      schedule();
    };

    const stop = () => {
      stopped = true;
      root.classList.add('is-stopped');
    };

    const keyMoves: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        stop();
        select(i);
      });
      tab.addEventListener('keydown', (e) => {
        if (e.key in keyMoves) {
          e.preventDefault();
          stop();
          select(index + keyMoves[e.key], true);
        } else if (e.key === 'Home' || e.key === 'End') {
          e.preventDefault();
          stop();
          select(e.key === 'Home' ? 0 : tabs.length - 1, true);
        }
      });
    });

    root.addEventListener('mouseenter', () => {
      hovering = true;
      clear();
    });
    root.addEventListener('mouseleave', () => {
      hovering = false;
      schedule();
    });

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible) schedule();
        else clear();
      },
      { threshold: 0.35 },
    ).observe(root);
  });
</script>

<style>
  .how {
    position: relative;
    overflow: hidden;
    color: #fff;
    background: var(--brand-900);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  .how__stage {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: center;
  }

  .how__visual {
    position: relative;
    display: grid;
    place-items: center;
  }

  .how__visual::before {
    /* amber floor marker behind the phone */
    content: '';
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1.5px dashed rgb(245 158 11 / 0.45);
    animation: turn 40s linear infinite;
  }

  .how__visual :global(.how__phone) {
    position: relative;
    width: min(300px, 70vw);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7);
  }

  .how__screens {
    position: absolute;
    inset: 0;
  }

  .how__screens :global(.how__screen) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.05);
    transition:
      opacity 0.6s var(--ease),
      transform 0.9s var(--ease);
  }

  .how__screens :global(.how__screen.is-active) {
    opacity: 1;
    transform: none;
  }

  /* Text panel */
  .how__panel {
    display: grid;
    gap: 2.5rem;
  }

  /* All step texts share one cell, so the height never jumps. */
  .how__texts {
    display: grid;
  }

  .how__text {
    grid-area: 1 / 1;
    display: grid;
    gap: 0.75rem;
    align-content: end;
    visibility: hidden;
  }

  .how__text.is-active {
    visibility: visible;
  }

  .how__text.is-active > * {
    animation: rise 0.6s var(--ease) both;
  }

  .how__text.is-active > :nth-child(2) {
    animation-delay: 0.06s;
  }

  .how__text.is-active > :nth-child(3) {
    animation-delay: 0.12s;
  }

  .how__big {
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 7vw, 9rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
  }

  .how__text h3 {
    font-size: var(--fs-xl);
    font-weight: 700;
  }

  .how__text p {
    max-width: 30rem;
    font-size: var(--fs-lg);
    color: rgb(255 255 255 / 0.72);
  }

  /* Step rail */
  .rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .rail__step {
    display: grid;
    gap: 0.5rem;
    padding: 0 0 0.5rem;
    text-align: left;
    color: rgb(255 255 255 / 0.5);
    transition: color 0.3s var(--ease);
  }

  .rail__step:hover,
  .rail__step[aria-selected='true'] {
    color: #fff;
  }

  .rail__bar {
    position: relative;
    height: 3px;
    background: rgb(255 255 255 / 0.15);
    overflow: hidden;
  }

  .rail__bar span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .rail__step[aria-selected='true'] .rail__bar span {
    transform: scaleX(1);
  }

  .rail__step.is-running .rail__bar span {
    animation: fill 5.5s linear both;
  }

  .rail__num {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 700;
    color: var(--accent);
  }

  .rail__title {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  @keyframes fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @keyframes turn {
    to {
      transform: rotate(1turn);
    }
  }

  @media (max-width: 899px) {
    .how__stage {
      grid-template-columns: 1fr;
    }

    .how__big {
      font-size: 4.5rem;
    }
  }

  @media (max-width: 559px) {
    .rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 0.75rem;
    }
  }
</style>
