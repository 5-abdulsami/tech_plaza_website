---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import SpecSheet from '@/components/ui/SpecSheet.astro';
import Button from '@/components/ui/Button.astro';
import PhoneFrame from '@/components/ui/PhoneFrame.astro';
import PriceTag from '@/components/ui/PriceTag.astro';
import { ownerFeatures } from '@/data/features';
import dashboard from '@/assets/screens/owner-dashboard.png';
import products from '@/assets/screens/owner-products.png';
---

<section class="section owners" aria-labelledby="owners-title">
  <div class="container">
    <SectionHeading
      index="04"
      label="For shop owners"
      id="owners-title"
      title="Your shop, open <span class='mark'>after closing time.</span>"
      lead="Customers search on their phones at midnight. Give them a storefront to browse, and a chat to use before they walk in."
      tone="inverse"
    />

    <div class="owners__grid">
      <div class="owners__visual" data-reveal="fade">
        <PhoneFrame src={products} alt="My products screen with four live listings" width={260} class="owners__phone owners__phone--back" />
        <PhoneFrame src={dashboard} alt="Shop owner dashboard with live listings, unread chats, rating and followers" width={280} class="owners__phone owners__phone--front" />
        <PriceTag class="owners__tag" eyebrow="Listing fee" value="Rs 0" note="Free for shops" tilt={7} />
      </div>

      <div class="owners__copy">
        <SpecSheet items={ownerFeatures} title="Spec sheet · Shop owner app" meta="Free" columns={1} tone="inverse" />
        <div class="owners__actions" data-reveal>
          <Button href="/shop-owners" variant="accent" size="lg">List your shop</Button>
          <Button href="/shop-owners#onboarding" variant="outline-light" size="lg" icon="arrow-right">How approval works</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .owners {
    --tag-hole: var(--brand);
    position: relative;
    overflow: clip;
    color: #fff;
    background: var(--brand);
  }

  .owners__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 1rem + 5vw, 6rem);
    align-items: start;
  }

  .owners__visual {
    position: sticky;
    top: calc(var(--header-h) + 3rem);
    width: min(100%, 440px);
    aspect-ratio: 1 / 1.2;
    margin-inline: auto;
  }

  .owners__visual :global(.owners__phone) {
    position: absolute;
    box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.6);
  }

  .owners__visual :global(.owners__phone--front) {
    width: 58%;
    left: 0;
    top: 6%;
    z-index: 1;
    rotate: -3deg;
  }

  .owners__visual :global(.owners__phone--back) {
    width: 52%;
    right: 0;
    top: 14%;
    rotate: 5deg;
    opacity: 0.85;
  }

  .owners__visual :global(.owners__tag) {
    position: absolute;
    z-index: 2;
    right: 4%;
    top: -4%;
  }

  .owners__copy {
    display: grid;
    gap: 2rem;
  }

  .owners__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  @media (max-width: 959px) {
    .owners__grid {
      grid-template-columns: 1fr;
    }

    .owners__visual {
      position: relative;
      top: auto;
      width: min(100%, 380px);
    }
  }

  @media (max-width: 559px) {
    .owners__actions {
      flex-direction: column;
    }

    .owners__actions :global(.btn__label) {
      flex: 1;
      justify-content: center;
    }
  }
</style>
