---
import PhoneFrame from '@/components/ui/PhoneFrame.astro';
import StoreButton from '@/components/ui/StoreButton.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import PriceTag from '@/components/ui/PriceTag.astro';
import Ticker from '@/components/ui/Ticker.astro';
import home from '@/assets/screens/customer-home.png';
import { categories, plazas } from '@/data/plazas';
import { site } from '@/config/site';

const perks = ['Browse without an account', 'Verified shops', 'Free'];
const tickerItems = categories.flatMap((c, i) => (plazas[i] ? [c, plazas[i].name] : [c]));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="label hero__label" data-reveal="fade">
        <span class="hero__live" aria-hidden="true"></span>
        {site.city} · {plazas.length} plazas · 1 app
      </p>

      <h1 id="hero-title" class="hero__title" data-reveal="wipe" style="--reveal-i:1">
        Know before <span class="mark">you go.</span>
      </h1>

      <p class="lead hero__lead" data-reveal style="--reveal-i:2">
        Every electronics shop in {site.city}’s tech plazas, on your phone. Compare prices, check what’s in stock,
        and chat with the shop before you make the trip.
      </p>

      <div class="hero__actions" data-reveal style="--reveal-i:3">
        <StoreButton />
        <Button href="/shop-owners" variant="secondary" size="lg">List your shop</Button>
      </div>

      <ul role="list" class="hero__perks" data-reveal style="--reveal-i:4">
        {
          perks.map((p) => (
            <li>
              <Icon name="check" size={14} strokeWidth={3} />
              {p}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visual" data-reveal="fade" style="--reveal-i:2">
      <span class="hero__slab" aria-hidden="true"></span>
      <PhoneFrame
        src={home}
        alt="Tech Plaza home screen listing products from local shops"
        width={320}
        eager
        class="hero__phone"
      />

      <PriceTag class="hero__tag" eyebrow="Dell Latitude 7490" value="Rs 75,000" note="Negotiable" tilt={-8} />

      <div class="plate" aria-hidden="true">
        <span class="plate__no">Shop #12 · Ground floor</span>
        <strong>Laptop Point</strong>
        <span class="plate__meta"><Icon name="star" size={13} class="plate__star" /> 4.3 · Dubai Plaza</span>
      </div>
    </div>
  </div>

  <Ticker items={tickerItems} class="hero__ticker" />
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2rem, 1rem + 4vw, 4.5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    padding-bottom: clamp(3.5rem, 2rem + 5vw, 6rem);
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: 1.6rem;
  }

  .hero__label {
    color: var(--text-2);
  }

  .hero__live {
    position: relative;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 2px;
  }

  .hero__live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background: var(--accent);
    animation: ping 2.2s var(--ease) infinite;
  }

  .hero__title {
    font-size: var(--fs-3xl);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 800;
    color: var(--brand);
  }

  .hero__title .mark {
    color: var(--slate-900);
  }

  .hero__lead {
    max-width: 33rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 0.25rem;
  }

  .hero__perks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--rule);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .hero__perks li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero__perks :global(svg) {
    color: var(--success);
  }

  /* Visual */
  .hero__visual {
    position: relative;
    width: min(100%, 440px);
    aspect-ratio: 1 / 1.22;
    margin-inline: auto;
  }

  /* Navy counter slab behind the phone */
  .hero__slab {
    position: absolute;
    left: 8%;
    right: 2%;
    top: 12%;
    bottom: 4%;
    border-radius: var(--radius-xl);
    background: var(--brand);
    background-image:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 44px),
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 44px);
  }

  .hero__visual :global(.hero__phone) {
    position: absolute;
    left: 22%;
    top: 0;
    width: 62%;
    rotate: -4deg;
    box-shadow: var(--shadow-lg);
  }

  .hero__visual :global(.hero__tag) {
    position: absolute;
    z-index: 2;
    right: -2%;
    top: 4%;
  }

  .plate {
    position: absolute;
    z-index: 2;
    left: 0;
    bottom: 12%;
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1.5px solid var(--slate-900);
    box-shadow: var(--shadow-hard);
    animation: bob 6s var(--ease-in-out) infinite;
  }

  .plate__no {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .plate strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .plate__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-2);
  }

  .plate :global(.plate__star) {
    color: var(--star);
    fill: var(--star);
  }

  @keyframes bob {
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  @media (max-width: 959px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__visual {
      width: min(100%, 400px);
    }
  }

  @media (max-width: 479px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .hero__actions > :global(*) {
      justify-content: center;
    }

    .hero__actions :global(.btn__label) {
      flex: 1;
      justify-content: center;
    }

    .plate {
      padding: 0.7rem 0.9rem;
    }

    .hero__visual :global(.hero__tag) {
      right: 0;
    }

    .plate strong {
      font-size: 1.05rem;
    }
  }
</style>
